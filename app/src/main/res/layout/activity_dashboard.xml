<?xml version="1.0" encoding="utf-8"?>
<!-- UI-04: Dashboard — stub for M02. Full implementation in M09. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/off_white">

    <!-- Navy toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_navy"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/randnest_logo"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cd_randnest_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/app_name"
            android:textColor="@color/off_white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Demo notice strip -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_teal"
        android:paddingVertical="6dp"
        android:text="@string/label_demo_notice"
        android:textColor="@color/off_white"
        android:textSize="11sp"
        android:gravity="center"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <!-- Placeholder content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/randnest_logo"
            android:scaleType="fitCenter"
            android:alpha="0.15"
            android:contentDescription="@string/cd_randnest_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/dashboard_title"
            android:textColor="@color/primary_navy"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Coming in M09 — accounts, balances and Safe-to-Spend"
            android:textColor="#888"
            android:textSize="13sp"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>
