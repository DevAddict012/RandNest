<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme inherits the same brand palette — navy/teal read well on dark. -->
    <style name="Base.Theme.Bank_system" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_teal</item>
        <item name="colorOnPrimary">@color/dark_navy</item>
        <item name="colorPrimaryContainer">@color/dark_navy</item>
        <item name="colorOnPrimaryContainer">@color/off_white</item>
        <item name="colorSecondary">@color/bright_teal</item>
        <item name="colorOnSecondary">@color/dark_navy</item>
        <item name="colorSurface">#1A2535</item>
        <item name="colorOnSurface">@color/off_white</item>
        <item name="android:colorBackground">#0F1923</item>
        <item name="android:windowBackground">#0F1923</item>
        <item name="android:statusBarColor">@color/dark_navy</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:navigationBarColor">@color/dark_navy</item>
        <item name="android:windowAnimationStyle">@style/RandNestWindowAnimation</item>
    </style>
</resources>